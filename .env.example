# 🔧 HH Bot Configuration Template
# ================================
# ВАЖНО: Это файл ПРИМЕРА. Создайте свой .env файл на основе этого!
# ВАЖНО: Никогда не коммитьте .env с реальными токенами!
# ⚠️  SECURITY: Все значения в .env являются конфиденциальными!

# ============================================================================
# 🤖 TELEGRAM BOT CONFIGURATION
# ============================================================================
# Получить токен: https://t.me/BotFather
# Инструкции:
#   1. Напишите @BotFather в Telegram
#   2. Отправьте /newbot
#   3. Выберите имя бота (например: my_hh_bot)
#   4. Выберите юзернейм (например: my_hh_bot)
#   5. Скопируйте полученный токен
# Формат: 123456789:ABCdefGHIjklMNOpqrSTuvwxyzABCDEFghi
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Пример: 8266259912:AAHUG16SHkOfwZvYxc9XOpcdJbKhP4m0xmM (НЕ ИСПОЛЬЗУЙТЕ ЭТОТ!)

# ============================================================================
# 🏢 HEADHUNTER API CONFIGURATION
# ============================================================================
# Получить credentials: https://dev.hh.ru/admin/applications
# Инструкции для HeadHunter OAuth:
#   1. Перейдите на https://dev.hh.ru/admin/applications
#   2. Нажмите "Создать приложение"
#   3. Заполните:
#      - Название: HH Bot Recruiting Tool
#      - Описание: Auto-recruiting bot for job vacancies
#      - Redirect URI: http://localhost:8000/auth/callback
#   4. Скопируйте Client ID и Client Secret
#   5. Сохраните их в .env (НИКОГДА в GitHub!)
HH_CLIENT_ID=your_hh_client_id_here
# Пример: 12ab34cd56ef78gh90ij12kl34mn56op78qr90st

HH_CLIENT_SECRET=your_hh_client_secret_here
# Пример: 12ab34cd56ef78gh90ij12kl34mn56op78qr90st12ab34cd56ef78

# Redirect URI для OAuth callback
# ВАЖНО: Должно совпадать с тем, что указано в приложении на dev.hh.ru
HH_REDIRECT_URI=http://localhost:8000/auth/callback
# Для production: HH_REDIRECT_URI=https://your-domain.com/auth/callback

# ============================================================================
# 👨‍💼 ADMIN CONFIGURATION
# ============================================================================
# Ваш Telegram Chat ID для получения уведомлений об ошибках
# Как узнать свой Chat ID:
#   1. Напишите @userinfobot в Telegram
#   2. Бот ответит вам с вашим ID
# Пример: 123456789
ADMIN_CHAT_ID=your_admin_chat_id_here

# ============================================================================
# 💾 STATE MANAGEMENT (FSM) CONFIGURATION
# ============================================================================
# Выберите способ сохранения состояния:
# - "memory" (быстро, теряется при перезагрузке)
# - "redis" (медленнее, сохраняется, нужен Redis)
FSM_STORAGE_TYPE=memory

# ============================================================================
# 🔴 REDIS CONFIGURATION (если FSM_STORAGE_TYPE=redis)
# ============================================================================
# Установка Redis:
#   Linux/Mac: brew install redis
#   Windows: https://github.com/microsoftarchive/redis/releases
#   Docker: docker run -d -p 6379:6379 redis:latest
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Если Redis требует пароль:
REDIS_PASSWORD=

# ============================================================================
# 📊 LOGGING CONFIGURATION
# ============================================================================
# Уровень логирования:
# - DEBUG (максимум информации)
# - INFO (важная информация)
# - WARNING (только предупреждения)
# - ERROR (только ошибки)
LOG_LEVEL=INFO

# Файл логов (путь и имя)
LOG_FILE=hh_bot.log

# Максимальный размер одного файла логов перед ротацией
LOG_ROTATION=100 MB

# Сколько старых файлов логов хранить
LOG_RETENTION=10 days

# ============================================================================
# 🤖 AUTO-RESPONSE CONFIGURATION
# ============================================================================
# Максимум автоответов в день (чтобы не заспамить)
MAX_RESPONSES_PER_DAY=200
# Пример: 10 - не более 10 откликов в день

# Задержка между ответами (в секундах) - чтобы не выглядеть ботом
RESPONSE_DELAY_SECONDS=30
# Пример: 60 - 60 секунд между откликами

# Включить автоматические ответы
# false = только ручные ответы
# true = автоматические ответы по расписанию
AUTO_RESPONSE_ENABLED=false

# ============================================================================
# 🔍 SEARCH CONFIGURATION
# ============================================================================
# На сколько дней в прошлое искать новые вакансии
DEFAULT_SEARCH_PERIOD_DAYS=3
# Пример: 1 - только вчерашние, 7 - за неделю

# Максимум вакансий при одном поиске
MAX_VACANCIES_PER_SEARCH=100
# Пример: 50 - не более 50 вакансий за раз

# Задержка между поисковыми запросами (в секундах)
SEARCH_DELAY_SECONDS=60
# Пример: 120 - 2 минуты между поисками

# ============================================================================
# 🌐 API CONFIGURATION
# ============================================================================
# Таймаут для API запросов (в секундах)
API_REQUEST_TIMEOUT=30
# Пример: 60 - ждем 60 секунд ответа от API

# Количество попыток повторить запрос при ошибке
API_RETRY_ATTEMPTS=3
# Пример: 5 - максимум 5 попыток

# Задержка между повторными попытками (в секундах)
API_RETRY_DELAY_SECONDS=5
# Пример: 10 - 10 секунд между повторами

# ============================================================================
# 📋 QUICK START
# ============================================================================
# 1. Скопируйте этот файл:
#    cp .env.example .env
#
# 2. Отредактируйте .env и добавьте ваши значения:
#    - TELEGRAM_BOT_TOKEN (от @BotFather)
#    - HH_CLIENT_ID (с dev.hh.ru)
#    - HH_CLIENT_SECRET (с dev.hh.ru)
#    - ADMIN_CHAT_ID (ваш ID в Telegram)
#
# 3. Убедитесь что .env в .gitignore:
#    cat .gitignore | grep "^.env"
#
# 4. Запустите бота:
#    python main.py
#
# 5. Проверьте логи:
#    tail -f hh_bot.log

# ============================================================================
# ⚠️  SECURITY REMINDERS
# ============================================================================
# - НИКОГДА не коммитьте .env файл на GitHub!
# - НИКОГДА не делитесь токенами с кем-либо!
# - Если токен скомпрометирован - удалите и создайте новый!
# - Используйте .env только для локальной разработки
# - Для production используйте переменные окружения в хостинге
# - GitHub Secrets для CI/CD (Settings → Secrets)
# - Vault/Secrets Manager для production

