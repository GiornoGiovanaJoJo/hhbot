# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# HeadHunter API
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
HH_REDIRECT_URI=http://localhost:8000/auth/callback

# Admin notifications (optional)
ADMIN_CHAT_ID=

# FSM Storage (memory or redis)
FSM_STORAGE_TYPE=memory

# Redis (if FSM_STORAGE_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=hh_bot.log
LOG_ROTATION=100 MB
LOG_RETENTION=10 days

# Auto responses
MAX_RESPONSES_PER_DAY=200
RESPONSE_DELAY_SECONDS=30
AUTO_RESPONSE_ENABLED=false

# Search settings
DEFAULT_SEARCH_PERIOD_DAYS=3
MAX_VACANCIES_PER_SEARCH=100
SEARCH_DELAY_SECONDS=60

# API settings
API_REQUEST_TIMEOUT=30
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_SECONDS=5
